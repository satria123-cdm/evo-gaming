# Copy to .env.local and fill with your own values.
# Local dev cluster runs on port 5433 (see scripts/db.mjs).
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/evo_gaming

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me
MOCK_GATEWAY_SECRET=change-me

# Used only by `npm run db:seed` to create/reset the owner account.
ADMIN_EMAIL=owner@evogaming.local
ADMIN_PASSWORD=change-me

# Payment mode: `mock` simulates QRIS (dummy QR + "Simulasi Bayar Berhasil").
# Leave unset or set to `gateway` in production; the real gateway is not wired yet.
PAYMENT_MODE=mock

# Public origin used by metadata, sitemap.xml, robots.txt, and JSON-LD.
# Local default below. On Render use the real URL, e.g.
# NEXT_PUBLIC_SITE_URL=https://evo-gaming.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
